# Required for Qwen chat, embedding and rerank requests.
DASHSCOPE_API_KEY=replace-with-your-key
SPRING_PROFILES_ACTIVE=demo

# Local development defaults used by Compose and Spring Boot.
MYSQL_ROOT_PASSWORD=portfolio-root
MYSQL_PASSWORD=portfolio
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=16379
MILVUS_HOST_PORT=29530
MILVUS_HEALTH_HOST_PORT=19091
ATTU_HOST_PORT=18000
ROCKETMQ_NAMESRV_HOST_PORT=19876
# Shared Trace Elasticsearch used by both repositories.
ELASTICSEARCH_HOST_PORT=19200

# Optional endpoint overrides.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
MALL_ORDER_BASE_URL=http://127.0.0.1:8081
MCP_SERVER_URL=http://127.0.0.1:8082
MALL_ORDER_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/products?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
AGENT_MEMORY_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/agent_memory?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
ROCKETMQ_NAMESRV_ADDR=127.0.0.1:19876
ELASTICSEARCH_URIS=http://127.0.0.1:19200
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
MILVUS_HOST=127.0.0.1
MILVUS_PORT=29530
# Authentication and service-to-service credentials (replace outside local demo)
DEMO_INITIAL_PASSWORD=DemoLogin@2026!
ADMIN_INITIAL_PASSWORD=Jyy@12345678
AGENT_EVALUATION_TOKEN=local-evaluation-token-change-me
AGENT_SECURE_COOKIE=false
MALL_ORDER_SERVICE_TOKEN=local-order-service-token-change-me
MCP_SERVICE_TOKEN=local-mcp-service-token-change-me
OBSERVABILITY_SERVICE_TOKEN=local-observability-token-change-me

# Agent answer feedback and encrypted bad-case snapshots.
AGENT_FEEDBACK_ENCRYPTION_KEY=replace-with-at-least-16-characters
AGENT_FEEDBACK_RETENTION_DAYS=90
AGENT_VERSION=dev
