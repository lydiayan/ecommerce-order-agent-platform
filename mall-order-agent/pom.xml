<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example</groupId>
        <artifactId>EcommSpringBot</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>com.css</groupId>
    <artifactId>mall-order-agent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>mall-order-agent</name>
    <description>Agent service with Milvus RAG integration</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 集成 RAG + Memory 模块（Memory 提供 HybridMemoryManager 等 Bean） -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>mall-order-milvus-rag</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>mall-order-memory</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- Spring AI Alibaba Graph：StateGraph / NodeAction / addEdge -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-graph-core</artifactId>
        </dependency>
        <!-- Agent Framework：ReactAgent、Hook、Checkpoint（已传递依赖 graph-core） -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-agent-framework</artifactId>
        </dependency>
        <!-- Graph 可观测性（可选，与 observability 模块配合） -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-starter-graph-observation</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.css.mallorderagent.MallOrderAgentApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
